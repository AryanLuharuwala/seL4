<?xml version="1.0" encoding="UTF-8"?>
<!--
  Microkit system description, milestone 2.

  Two PDs exchange IMU samples over a shared-memory ring protected by
  a seqlock. Both PDs carry MCS attributes (period/budget in
  microseconds) so their CPU consumption is bounded — the same
  mechanism that will cap the untrusted mavlink_radio PD in later
  milestones.
-->
<system>

    <!-- 4 KiB of shared memory: a seq counter plus a 16-slot ring. -->
    <memory_region name="imu_shm" size="0x1000" />

    <protection_domain name="imu_driver" priority="200" period="1000" budget="100">
        <program_image path="imu_driver.elf" />
        <map mr="imu_shm" vaddr="0x2_000_000" perms="rw" cached="true"
             setvar_vaddr="imu_shm" />
    </protection_domain>

    <protection_domain name="estimator" priority="199" period="1000" budget="300">
        <program_image path="estimator.elf" />
        <!-- Read-only mapping: estimator cannot corrupt the IMU ring. -->
        <map mr="imu_shm" vaddr="0x2_000_000" perms="r" cached="true"
             setvar_vaddr="imu_shm" />
    </protection_domain>

    <channel>
        <end pd="imu_driver" id="0" />
        <end pd="estimator"  id="0" />
    </channel>

</system>
