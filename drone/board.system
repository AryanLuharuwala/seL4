<?xml version="1.0" encoding="UTF-8"?>
<!--
  Microkit system description for milestone 1.

  Two protection domains exchange notifications over a single channel.
  This is the skeleton that later milestones will extend: `pinger` becomes
  the IMU driver, `ponger` becomes the estimator, and further PDs
  (flight_ctrl, geofence, motor_driver, mavlink_radio) are added with
  channels that encode the trust boundaries.
-->
<system>

    <protection_domain name="pinger" priority="100">
        <program_image path="pinger.elf" />
    </protection_domain>

    <protection_domain name="ponger" priority="99">
        <program_image path="ponger.elf" />
    </protection_domain>

    <channel>
        <end pd="pinger" id="0" />
        <end pd="ponger" id="0" />
    </channel>

</system>
